{"data":{"mname":"annomate","version":1,"category":"data","table":"annomate","hname":"ann-o-mate","desc":"Query annotations, including JSON-LD and Turtle descriptions as Audiovisual Core regions of interest. Individual annotations are available at \/annotation\/{source}\/{annotation_id}.","source_notes":"Annotations are of three kinds: those people made, such as xeno-canto's; the regions of interest of a corpus, which are linked to it (see Links); and Sounds of Norway's, which are detections by BirdNET-Lite, with BirdNet-Lite as their annotator. source_id is the id of the recording an annotation marks, at recording_source, and annotation_id the annotation's own. time_start and time_end are seconds from the start of the recording, and freq_low and freq_high the frequencies that bound a region in Hz, where it has them. All four are matched as text, not as numbers.","rdf":{"path":"annotation","id":"annotation_id","links":true,"node":"annomate_rdf_node","related":"annomate_rdf_related"},"params":{"source":{"desc":"Source of the annotation, by its exact name (letter case aside)","type":"string","default":"","column":"source","op":"=","autocomplete":true,"multiple":false},"source_id":{"desc":"Recording ID","type":"string","default":"","column":"source_id","op":"=","multiple":true,"autocomplete":true},"recording_source":{"desc":"Source of the recording, which need not be the annotation's (e.g. a corpus marking regions of xeno-canto recordings)","type":"string","default":"","column":"recording_source","op":"=","autocomplete":true,"multiple":false},"annotator":{"desc":"Annotator","type":"string","default":"","column":"annotator","op":"contains","autocomplete":true,"multiple":false},"annotation_id":{"desc":"Annotation ID","type":"string","default":"","column":"annotation_id","op":"=","multiple":true,"autocomplete":true},"annotation_date":{"desc":"Annotation date","type":"string","default":"","column":"annotation_date","op":"contains","autocomplete":false,"multiple":false},"annotation_info_url":{"desc":"Annotation information link","type":"string","default":"","column":"annotation_info_url","op":"contains","autocomplete":false,"multiple":false},"recording_url":{"desc":"Recording URL","type":"string","default":"","column":"recording_url","op":"contains","autocomplete":false,"ac":"ac:accessURI","multiple":false},"time_start":{"desc":"Start time","type":"string","default":"","column":"time_start","op":"=","autocomplete":false,"ac":"ac:startTime","multiple":false},"time_end":{"desc":"End time","type":"string","default":"","column":"time_end","op":"=","autocomplete":false,"ac":"ac:endTime","multiple":false},"freq_low":{"desc":"Lowest frequency of the region, in Hz","type":"string","default":"","column":"freq_low","op":"=","autocomplete":false,"ac":"ac:freqLow","multiple":false},"freq_high":{"desc":"Highest frequency of the region, in Hz","type":"string","default":"","column":"freq_high","op":"=","autocomplete":false,"ac":"ac:freqHigh","multiple":false},"taxon":{"desc":"Taxon","type":"string","default":"","column":"taxon","op":"contains","autocomplete":true,"ac":"dwc:scientificName","multiple":false},"type":{"desc":"Annotation type","type":"string","default":"","column":"type","op":"contains","autocomplete":true,"multiple":false},"lat":{"desc":"Latitude","type":"string","default":"","column":"lat","op":"contains","autocomplete":false,"ac":"dwc:decimalLatitude","multiple":false},"lon":{"desc":"Longitude","type":"string","default":"","column":"lon","op":"contains","autocomplete":false,"ac":"dwc:decimalLongitude","multiple":false},"contact":{"desc":"Contact","type":"string","default":"","column":"contact","op":"contains","autocomplete":true,"multiple":false},"format":{"desc":"Data representation to return.","type":"string","allowed":["internal","ac"],"default":"internal"},"output":{"desc":"The format of the returned data","type":"string","allowed":["JSON","nakedJSON","tabulator","JSON-LD","Turtle"],"default":"JSON","column":"","op":""}}},"params"